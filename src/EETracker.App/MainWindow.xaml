<Window x:Class="EETracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zombies Tracker" Width="1600" Height="940" MinWidth="1100" MinHeight="720"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextMain}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- Fixed, quiet navigation rail for the second-screen layout. -->
  <Border Grid.Column="0" Background="#101514" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="18,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="ZOMBIES" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="TRACKER" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0"/><TextBlock Text="FIELD COMPANION" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="10" Margin="2,7,0,0"/></StackPanel>
    <Border Grid.Row="2" Height="1" Background="{StaticResource Line}"/>
    <StackPanel Grid.Row="3" Margin="0,15,0,0">
      <Button Content="◎   CURRENT" Click="ShowMain" Style="{StaticResource RailActiveButton}"/>
      <Button Content="▤   FULL QUEST" Click="ShowMain" Style="{StaticResource RailButton}"/>
      <Button Content="♟   SESSION" Click="ShowDiagnostics" Style="{StaticResource RailButton}"/>
     </StackPanel>
     <StackPanel Grid.Row="4"><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/><Button Content="⚙   SETTINGS" Click="ShowSettings" Style="{StaticResource RailButton}"/><Button Content="⌁   DIAGNOSTICS" Click="ShowDiagnostics" Style="{StaticResource RailButton}"/><TextBlock Text="OBSERVER ONLY" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold" Margin="8,18,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="22,18,22,14">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid x:Name="MissionPage">
     <Grid.RowDefinitions><RowDefinition Height="174"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <!-- Original cinematic map artwork and session summary; all controls remain native WPF. -->
     <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="4.7*" MinWidth="350"/><ColumnDefinition Width="0.72*" MinWidth="110"/><ColumnDefinition Width="0.72*" MinWidth="110"/><ColumnDefinition Width="1.25*" MinWidth="190"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True" Margin="0,0,10,0" CornerRadius="3">
       <Grid><Image x:Name="BannerArtwork" Source="/Assets/ascension-banner.png" Stretch="UniformToFill"/><Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#A8090D0B" Offset="0"/><GradientStop Color="#24090D0B" Offset="0.52"/><GradientStop Color="#78090D0B" Offset="1"/></LinearGradientBrush></Border.Background></Border><Grid Margin="20,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="MISSION BRIEF   /   ZOMBIES TRACKER" Foreground="#D5DFDA" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
        <StackPanel Grid.Row="2"><TextBlock x:Name="MapTitle" Text="AWAITING SESSION" FontFamily="Bahnschrift SemiCondensed" FontSize="48" FontWeight="Bold"/><TextBlock x:Name="QuestTitle" Text="MAIN QUEST" Foreground="#D5DFDA" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Margin="2,-3,0,0"/></StackPanel>
       </Grid></Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,10,0" CornerRadius="3" Padding="18,15"><StackPanel VerticalAlignment="Center"><TextBlock Text="ROUND" Style="{StaticResource Label}"/><TextBlock x:Name="RoundText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="48" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="CURRENT WAVE" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,1,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,10,0" CornerRadius="3" Padding="18,15"><StackPanel VerticalAlignment="Center"><TextBlock Text="PLAYERS" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0"><TextBlock x:Name="PlayersText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="48" FontWeight="Bold"/><TextBlock Text=" / 4" Foreground="{StaticResource TextMuted}" FontSize="16" VerticalAlignment="Bottom" Margin="4,0,0,5"/></StackPanel><TextBlock Text="IN SESSION" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,1,0,0"/></StackPanel></Border>
      <Border Grid.Column="3" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="18,15"><StackPanel VerticalAlignment="Center"><TextBlock Text="CONNECTION" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="ConnectionDot" Width="13" Height="13" Fill="{StaticResource AccentAmber}" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock x:Name="ConnectionText" Text="WAITING" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="Bold"/></StackPanel><TextBlock Text="PLUTONIUM T5" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="18,5,0,0"/></StackPanel></Border>
     </Grid>
     <!-- At normal widths, objective, preparation, and next step share one aligned band. -->
     <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0" CornerRadius="3">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,11"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" Foreground="{StaticResource TextSoft}" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="CURRENT OBJECTIVE" Style="{StaticResource SectionHeading}"/></StackPanel><Border x:Name="DetectionBadge" DockPanel.Dock="Right" Background="#17271E" BorderBrush="#5A9870" BorderThickness="1" Padding="10,5" CornerRadius="2"><TextBlock x:Name="DetectionText" Text="QUEST STATE" Foreground="{StaticResource AccentOlive}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/></Border></DockPanel></Border>
        <Grid Grid.Row="1" Margin="26,12,26,14">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <StackPanel Margin="0,4,0,0" HorizontalAlignment="Stretch">
          <TextBlock x:Name="ObjectiveText" Text="Waiting for game session" FontFamily="Bahnschrift SemiCondensed" FontSize="38" FontWeight="Bold" Foreground="{StaticResource AccentGold}" TextWrapping="Wrap" Margin="0,0,0,5"/>
          <TextBlock x:Name="InstructionText" Text="Connect to a game or load a preview." Foreground="{StaticResource TextSoft}" FontSize="17" TextWrapping="Wrap" LineHeight="26" MaxWidth="900" HorizontalAlignment="Left"/>
         </StackPanel>
         <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
          <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="780">
           <TextBlock x:Name="PressureTimerText" Visibility="Collapsed" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
           <TextBlock x:Name="LunaProgressText" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
           <TextBlock x:Name="SamanthaPromptText" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
           <TextBlock x:Name="RichtofenCueText" Visibility="Collapsed" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
           <Grid x:Name="TrackerProgressPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="156"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="QuestRingContainer" Grid.Column="1" Width="156" Height="156" HorizontalAlignment="Center"><Ellipse Stroke="#3E4744" StrokeThickness="12"/><Path x:Name="QuestRingProgress" Stroke="{StaticResource AccentGold}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="QuestRingText" Text="0 / 0" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="QuestRingLabel" Text="CHECKS" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Grid>
            <ItemsControl x:Name="StepTrackers" Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,0,0,8" CornerRadius="2"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="Bold" Margin="14,0,0,0"/></DockPanel><ProgressBar Height="7" Minimum="0" Maximum="{Binding Maximum, Mode=OneWay}" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding ProgressBarVisibility}" Margin="0,10,0,0" Background="{StaticResource Line}" Foreground="{StaticResource AccentGold}" BorderThickness="0"/><ItemsControl ItemsSource="{Binding Checkpoints}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontSize="19" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextMain}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding MarkerBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Grid>
           <StackPanel x:Name="SoulTanksPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" MaxWidth="620" Margin="0,12,0,0"><TextBlock Text="MOON SOUL CANISTERS" Style="{StaticResource Label}" Margin="8,6,8,6" HorizontalAlignment="Center"/><UniformGrid Columns="2" Margin="8,0,8,8"><StackPanel x:Name="SoulTank1Panel" Margin="0,0,14,14"><TextBlock Text="CANISTER 1" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank1Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank1Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank2Panel" Margin="0,0,0,14"><TextBlock Text="CANISTER 2" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank2Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank2Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank3Panel" Margin="0,0,14,0"><TextBlock Text="CANISTER 3" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank3Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank3Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank4Panel"><TextBlock Text="CANISTER 4" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank4Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank4Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel></UniformGrid></StackPanel>
          </StackPanel>
          </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,10"><DockPanel LastChildFill="False"><TextBlock x:Name="ObjectiveCounter" Text="FLOW NOT LOADED" Foreground="{StaticResource AccentOlive}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RecentSignalText" Text="Awaiting quest signal" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
       </Grid>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="0.9*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Grid.Row="0" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,10" CornerRadius="3">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="17,11"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="⚒" Foreground="{StaticResource TextSoft}" FontSize="23" Margin="0,0,13,0"/><TextBlock Text="PREPARATION" Style="{StaticResource SectionHeading}"/></StackPanel><TextBlock Text="BEFORE YOU MOVE" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/></DockPanel></Border>
         <ItemsControl x:Name="PreparationItems" Grid.Row="1" Margin="18,4,18,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding Text}" Grid.Column="1" Foreground="{StaticResource TextMain}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,8,4" LineHeight="21"/><TextBlock Text="{Binding Status}" Grid.Column="2" Foreground="{Binding MarkerBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/><Border Grid.ColumnSpan="3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Grid>
       </Border>
       <Border Grid.Row="1" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,10" CornerRadius="3">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="17,11"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="»" Foreground="{StaticResource TextSoft}" FontSize="27" FontWeight="Bold" Margin="0,0,13,0"/><TextBlock Text="NEXT STEP" Style="{StaticResource SectionHeading}"/></StackPanel><TextBlock Text="UP NEXT" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/></DockPanel></Border>
         <StackPanel Grid.Row="1" Margin="22,15,22,15" VerticalAlignment="Center"><TextBlock x:Name="NextText" Text="Waiting for quest signals." FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="NextInstructionText" Visibility="Collapsed" Foreground="{StaticResource TextSoft}" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0"/><TextBlock x:Name="PreviousText" Text="Previous: —" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,13,0,0" TextWrapping="Wrap"/></StackPanel>
        </Grid>
       </Border>
       <Border Grid.Row="2" Background="#1B231E" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,10" CornerRadius="3"><DockPanel LastChildFill="False"><TextBlock Text="POWER" Style="{StaticResource Label}"/><TextBlock x:Name="PowerText" Text="—" DockPanel.Dock="Right" Foreground="{StaticResource TextMain}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="RouteText" Text="ROUTE AUTOMATIC" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="18,0,0,0"/></DockPanel></Border>
      </Grid>
     </Grid>
     <!-- Same ordered projection as the QuestEngine, presented as a quiet, scroll-safe timeline. -->
     <Border x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="21,9"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="▥" Foreground="{StaticResource TextSoft}" FontSize="23" Margin="0,0,13,0"/><TextBlock Text="EASTER EGG PROGRESS" Style="{StaticResource SectionHeading}"/></StackPanel><TextBlock x:Name="ProgressText" Text="0 / 0 stages complete" DockPanel.Dock="Right" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel></Border>
       <ProgressBar x:Name="QuestProgressBar" Grid.Row="1" Height="3" Margin="20,11,20,0" Minimum="0" Maximum="100" Value="0" Background="{StaticResource Line}" Foreground="{StaticResource AccentOlive}" BorderThickness="0"/>
       <ItemsControl x:Name="ProgressList" Grid.Row="2" Margin="20,19,20,13"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,4,0"><Border Height="3" Background="{Binding ConnectorBrush}"/><Ellipse Width="27" Height="27" Margin="0,-15,0,5" HorizontalAlignment="Center" Fill="{Binding MarkerFill}" Stroke="{Binding MarkerBrush}" StrokeThickness="2"/><TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-27,0,10"/><TextBlock Text="{Binding ShortTitle}" Foreground="{Binding TitleBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="126" MaxHeight="40" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="8,10"><TextBlock Text="PREFERENCES" Style="{StaticResource Label}"/><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,11,0,8"/><TextBlock Text="Choose a sample mission or connect an event file from your game. Player count, route, and objectives follow the active script." Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" FontSize="14"/>
     <TextBox x:Name="PathBox" Margin="0,18,0,12" Padding="12" FontSize="13"/>
     <WrapPanel Margin="0,0,0,12"><ComboBox x:Name="SampleBox" Width="255" SelectedIndex="0" Padding="8" Margin="0,0,10,0"><ComboBoxItem Content="Ascension · Sample Run" Tag="ascension-session.jsonl"/><ComboBoxItem Content="Call of the Dead · Generator Preview" Tag="call-of-the-dead-session.jsonl"/><ComboBoxItem Content="Shangri-La · Tile Progress Preview" Tag="shangri-la-session.jsonl"/><ComboBoxItem Content="Moon · Soul Tube Preview" Tag="moon-session.jsonl"/><ComboBoxItem Content="Moon · Samantha Says Preview" Tag="moon-samantha-session.jsonl"/><ComboBoxItem Content="Moon · Panel Hack Preview" Tag="moon-panels-session.jsonl"/></ComboBox><Button Content="LOAD BUILT-IN PREVIEW" Click="LoadBuiltInSample" Style="{StaticResource ActionButton}"/></WrapPanel>
     <WrapPanel><Button Content="CHOOSE SESSION FILE" Click="BrowseSource" Style="{StaticResource ActionButton}"/><Button Content="PLAY SAVED SESSION" Click="LoadReplay" Style="{StaticResource ActionButton}"/><Button Content="CONNECT TO GAME" Click="ConnectT5File" Style="{StaticResource ActionButton}"/><Button Content="FOLLOW SESSION FILE" Click="LoadTail" Style="{StaticResource ActionButton}"/></WrapPanel>
     <Border x:Name="PathChoicePanel" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,22,0,0"><StackPanel><TextBlock Text="CALL OF THE DEAD ROUTE" Style="{StaticResource Label}"/><TextBlock Text="Choose the branch for this lobby. The tracker will keep both routes separate until the route is confirmed." Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,8,0,10"/><WrapPanel><ComboBox x:Name="PathChoiceBox" Width="220" SelectedIndex="0" Padding="8" Margin="0,0,10,0"><ComboBoxItem Content="Stand-In" Tag="stand_in"/><ComboBoxItem Content="Ensemble Cast" Tag="ensemble_cast"/></ComboBox><Button Content="USE THIS ROUTE" Click="ApplyPathChoice" Style="{StaticResource ActionButton}"/></WrapPanel></StackPanel></Border>
     <TextBlock x:Name="SettingsStatus" Margin="0,18,0,0" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"/>
     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,22,0,0" CornerRadius="3"><StackPanel><TextBlock Text="ARTWORK &amp; CREDITS" Style="{StaticResource Label}"/><TextBlock Text="Map banner panoramas are original AI-generated environment artwork made for this app with OpenAI image generation. They contain no game UI, logos, or external image sources." Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="22"/></StackPanel></Border>
    </StackPanel></ScrollViewer></Grid>
    <Grid x:Name="DiagnosticsPage" Visibility="Collapsed"><StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="8,10"><TextBlock Text="SESSION STATUS" Style="{StaticResource Label}"/><TextBlock Text="Diagnostics" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20" CornerRadius="3"><TextBlock x:Name="DiagnosticsText" Foreground="{StaticResource TextSoft}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" LineHeight="22"/></Border></StackPanel></Grid>
   </Grid>
   <DockPanel Grid.Row="1" LastChildFill="False" Margin="1,9,1,0"><TextBlock Text="ZOMBIES TRACKER  /  FIELD COMPANION" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/><TextBlock Text="TELEMETRY OBSERVER" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/></DockPanel>
  </Grid>
 </Grid>
</Window>











