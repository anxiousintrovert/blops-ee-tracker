<Window x:Class="EETracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zombies Tracker" Width="1600" Height="940" MinWidth="1100" MinHeight="720"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextMain}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- Fixed, quiet navigation rail for the second-screen layout. -->
  <Border Grid.Column="0" Background="#101514" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid x:Name="SidebarGrid" Margin="18,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button x:Name="SidebarToggle" Content="☰   COLLAPSE" Click="ToggleSidebar" Style="{StaticResource RailButton}" HorizontalContentAlignment="Left" Padding="8,9" Margin="0,0,0,12" ToolTip="Collapse navigation"/>
    <Grid x:Name="SidebarContents" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="ZOMBIES" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="TRACKER" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0"/><TextBlock Text="FIELD COMPANION" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="10" Margin="2,7,0,0"/><UniformGrid Columns="2" Margin="2,15,2,0"><Button x:Name="Bo1Tab" Content="BO1" Click="SelectBo1" Style="{StaticResource RailActiveButton}" Padding="4,9" HorizontalContentAlignment="Center"/><Button x:Name="Bo2Tab" Content="BO2" Click="SelectBo2" Style="{StaticResource RailButton}" Padding="4,9" HorizontalContentAlignment="Center"/></UniformGrid></StackPanel>
    <Border Grid.Row="2" Height="1" Background="{StaticResource Line}"/>
    <StackPanel Grid.Row="3" Margin="0,15,0,0">
      <Button Content="◎   CURRENT" Click="ShowMain" Style="{StaticResource RailActiveButton}"/>
      <Button Content="▤   FULL QUEST" Click="ShowFullQuest" Style="{StaticResource RailButton}"/>
      <Button Content="♫   SIDE EASTER EGGS" Click="ShowSideEasterEggs" Style="{StaticResource RailButton}"/>
      <Button Content="♟   SESSION" Click="ShowDiagnostics" Style="{StaticResource RailButton}"/>
     </StackPanel>
     <StackPanel Grid.Row="4"><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/><Button Content="⚙   SETTINGS" Click="ShowSettings" Style="{StaticResource RailButton}"/><Button Content="⌁   DIAGNOSTICS" Click="ShowDiagnostics" Style="{StaticResource RailButton}"/><TextBlock Text="OBSERVER ONLY" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold" Margin="8,18,0,0"/></StackPanel>
    </Grid>
    <StackPanel x:Name="SidebarCompactContents" Grid.Row="1" Visibility="Collapsed">
     <Button Content="B1" Click="SelectBo1" Style="{StaticResource RailButton}" Padding="5,8" ToolTip="Black Ops 1"/>
     <Button Content="B2" Click="SelectBo2" Style="{StaticResource RailButton}" Padding="5,8" ToolTip="Black Ops 2"/>
     <Button Content="◎" Click="ShowMain" Style="{StaticResource RailActiveButton}" Padding="5,8" ToolTip="Current objective"/>
     <Button Content="▤" Click="ShowFullQuest" Style="{StaticResource RailButton}" Padding="5,8" ToolTip="Full quest"/>
     <Button Content="♫" Click="ShowSideEasterEggs" Style="{StaticResource RailButton}" Padding="5,8" ToolTip="Side Easter eggs"/>
     <Button Content="♟" Click="ShowDiagnostics" Style="{StaticResource RailButton}" Padding="5,8" ToolTip="Session"/>
     <Button Content="⚙" Click="ShowSettings" Style="{StaticResource RailButton}" Padding="5,8" ToolTip="Settings"/>
     <Button Content="⌁" Click="ShowDiagnostics" Style="{StaticResource RailButton}" Padding="5,8" ToolTip="Diagnostics"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="MainContent" Grid.Column="1" Margin="22,18,22,14">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid x:Name="MissionPage">
      <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*" MinHeight="330"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,10" CornerRadius="3" Padding="12,4">
       <DockPanel LastChildFill="True" VerticalAlignment="Center">
        <Button x:Name="PreparationToggle" DockPanel.Dock="Right" Content="☷  PREPARATION" Click="TogglePreparation" Style="{StaticResource RailButton}" Padding="12,5" ToolTip="Preparation checklist"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="ROUND " Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="RoundText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" Margin="0,0,14,0"/><TextBlock Text="PLAYERS " Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="PlayersText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" Margin="0,0,14,0"/><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="{StaticResource AccentAmber}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="ConnectionText" Text="WAITING" FontFamily="Consolas" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="RuntimeText" Text="PLUTONIUM T5" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="MapTitle" Text="AWAITING SESSION" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="Bold"/><TextBlock Text="  /  " Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="QuestTitle" Text="MAIN QUEST" Foreground="{StaticResource TextSoft}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
       </DockPanel>
      </Border>
      <Popup x:Name="PreparationPopup" PlacementTarget="{Binding ElementName=PreparationToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
       <Border Width="390" MaxHeight="500" Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PreparationItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding IconPath}" Width="26" Height="26" Stretch="Uniform" ToolTip="In-game item art"/><CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="PreparationRequirementToggled" Unchecked="PreparationRequirementToggled" VerticalAlignment="Center"/><TextBlock Text="{Binding Text}" TextDecorations="{Binding TextDecorations}" Grid.Column="2" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,3,4,3"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
       </Border>
      </Popup>
      <Border x:Name="WaitingMatchOverlay" Grid.Row="0" Visibility="Collapsed" Background="#F0131917" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10" IsHitTestVisible="False">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="MATCH MONITOR" Foreground="{StaticResource AccentGold}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/><TextBlock Text="  ·  WAITING FOR MATCH  ·  Listening for Black Ops 1 or 2" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
     </Border>
     <!-- At normal widths, objective, preparation, and next step share one aligned band. -->
      <Grid Grid.Row="1" Margin="0,0,0,14">
      <Border Grid.Column="0" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0" CornerRadius="3">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,11"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" Foreground="{StaticResource TextSoft}" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="CURRENT OBJECTIVE" Style="{StaticResource SectionHeading}"/></StackPanel><Border x:Name="DetectionBadge" DockPanel.Dock="Right" Background="#17271E" BorderBrush="#5A9870" BorderThickness="1" Padding="10,5" CornerRadius="2"><TextBlock x:Name="DetectionText" Text="QUEST STATE" Foreground="{StaticResource AccentOlive}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/></Border></DockPanel></Border>
        <Grid Grid.Row="1" Margin="26,12,26,14">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="180"/></Grid.RowDefinitions>
         <StackPanel Margin="0,4,0,0" HorizontalAlignment="Stretch">
          <TextBlock x:Name="ObjectiveText" Text="Waiting for game session" FontFamily="Bahnschrift SemiCondensed" FontSize="38" FontWeight="Bold" Foreground="{StaticResource AccentGold}" TextWrapping="Wrap" Margin="0,0,0,5"/>
          <TextBlock x:Name="InstructionText" Text="Connect to a game or load a preview." Foreground="{StaticResource TextSoft}" FontSize="17" TextWrapping="Wrap" LineHeight="26" MaxWidth="900" HorizontalAlignment="Left"/>
         </StackPanel>
         <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
          <StackPanel HorizontalAlignment="Stretch">
            <ItemsControl x:Name="ObjectiveChecklistItems" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8" Margin="0,0,0,7" CornerRadius="2"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Items}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding IconPath}" Width="25" Height="25" Stretch="Uniform" ToolTip="In-game item art"/><CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="ObjectiveChecklistItemToggled" Unchecked="ObjectiveChecklistItemToggled" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Label}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Location}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextSoft}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
           <Border x:Name="TempleTilePanel" Visibility="Collapsed" Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,8,0,7" CornerRadius="2"><StackPanel><TextBlock x:Name="TempleTilePanelTitle" Text="TILE TRACKER" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="TempleTilePanelHelp" Foreground="{StaticResource TextSoft}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/><StackPanel x:Name="TempleGlyphBanks" Visibility="Collapsed"><ItemsControl x:Name="TempleTileBanksItems"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSoft}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/><ItemsControl ItemsSource="{Binding Tiles}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{Binding BorderBrush}" BorderThickness="1" Background="#202725" Margin="2" Height="58" CornerRadius="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding IconPath}" Width="52" Height="52" Stretch="Uniform" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Fill="{Binding LeftBrush}" Opacity="0.38"/><Rectangle Grid.Column="1" Fill="{Binding RightBrush}" Opacity="0.38"/><Border Grid.ColumnSpan="2" Background="#B0181D1C" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="2,0"><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMain}" FontFamily="Consolas" FontSize="8" FontWeight="Bold"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel x:Name="DieRiseTileSequencePanel" Visibility="Collapsed"><DockPanel><TextBlock Text="ORDER" Foreground="{StaticResource TextSoft}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DieRiseTileSequenceStatus" DockPanel.Dock="Right" Foreground="{StaticResource AccentGold}" FontSize="10" FontWeight="Bold"/></DockPanel><ItemsControl x:Name="DieRiseTileSequenceItems" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202725" BorderBrush="{Binding Brush}" BorderThickness="1" Padding="9,7" Margin="2" CornerRadius="2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding Marker}" Foreground="{Binding Brush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0"/><StackPanel><TextBlock Text="{Binding Position}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9"/><TextBlock Text="{Binding Direction}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel x:Name="DieRiseFloorSymbolsPanel" Visibility="Collapsed"><DockPanel><TextBlock Text="FLOOR SYMBOL STEPS" Foreground="{StaticResource TextSoft}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DieRiseFloorSymbolStatus" DockPanel.Dock="Right" Foreground="{StaticResource AccentGold}" FontSize="10" FontWeight="Bold"/></DockPanel><ItemsControl x:Name="DieRiseFloorSymbolItems" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202725" BorderBrush="{Binding Brush}" BorderThickness="1" Padding="12,8" Margin="2" CornerRadius="2"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding Marker}" Foreground="{Binding Brush}" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Position, StringFormat=STEP {0}}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9"/><TextBlock Text="{Binding State}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></Border>
           <TextBlock x:Name="PressureTimerText" Visibility="Collapsed" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
           <TextBlock x:Name="LunaProgressText" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
           <TextBlock x:Name="SamanthaPromptText" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
             <TextBlock x:Name="RichtofenCueText" Visibility="Collapsed" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
             <Border x:Name="DoorGuidePanel" Visibility="Collapsed" Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8" Margin="0,10,0,0"><StackPanel><TextBlock Text="DOORS FOR THIS STEP" Style="{StaticResource Label}"/><ItemsControl x:Name="DoorGuideItems" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" FontSize="12" Margin="2,2" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
           <Border x:Name="BranchOptionsPanel" Visibility="Collapsed" Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="PATH CHOICE · A RICHTOFEN  /  B MAXIS" Style="{StaticResource Label}" Margin="2,0,2,3"/><TextBlock Text="Follow one route in-game. The observer will confirm which path your lobby starts." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,7"/><ItemsControl x:Name="BranchOptionsItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="4" CornerRadius="2"><StackPanel><TextBlock Text="{Binding ChoiceLabel}" Foreground="{StaticResource AccentGold}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding FirstObjective}" Foreground="{StaticResource TextMain}" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,4"/><TextBlock Text="{Binding Instruction}" Foreground="{StaticResource TextSoft}" FontSize="13" TextWrapping="Wrap" LineHeight="19"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
           <Grid x:Name="TrackerProgressPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="156"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <ItemsControl x:Name="StepTrackers" Grid.Column="0" Grid.ColumnSpan="3" Margin="0" VerticalAlignment="Top"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,0,0,8" CornerRadius="2"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="Bold" Margin="14,0,0,0"/></DockPanel><ProgressBar Height="7" Minimum="0" Maximum="{Binding Maximum, Mode=OneWay}" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding ProgressBarVisibility}" Margin="0,10,0,0" Background="{StaticResource Line}" Foreground="{StaticResource AccentGold}" BorderThickness="0"/><ItemsControl ItemsSource="{Binding Checkpoints}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontSize="19" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Label}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextMain}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding MarkerBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Grid>
           <StackPanel x:Name="SoulTanksPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,12,0,0"><TextBlock Text="MOON SOUL CANISTERS" Style="{StaticResource Label}" Margin="8,6,8,6" HorizontalAlignment="Center"/><UniformGrid Columns="1" Margin="8,0,8,8"><StackPanel x:Name="SoulTank1Panel" Margin="0,0,0,10"><TextBlock Text="CANISTER 1" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank1Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank1Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank2Panel" Margin="0,0,0,10"><TextBlock Text="CANISTER 2" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank2Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank2Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank3Panel" Margin="0,0,0,10"><TextBlock Text="CANISTER 3" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank3Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank3Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank4Panel"><TextBlock Text="CANISTER 4" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank4Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank4Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel></UniformGrid></StackPanel>
          </StackPanel>
          </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,10"><DockPanel LastChildFill="False"><TextBlock x:Name="ObjectiveCounter" Text="FLOW NOT LOADED" Foreground="{StaticResource AccentOlive}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RecentSignalText" Text="Awaiting quest signal" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
       </Grid>
      </Border>
      </Grid>
     <!-- Same ordered projection as the QuestEngine, presented as a quiet, scroll-safe timeline. -->
     <Border x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" MinHeight="112" MaxHeight="168" VerticalAlignment="Bottom" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10,5,10,4">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel><TextBlock Text="QUEST FLOW" Style="{StaticResource Label}"/><TextBlock x:Name="ProgressText" Text="STEP 0 / 0" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/></DockPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsControl x:Name="ProgressList" Margin="4,8,4,2"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="240" Margin="0,0,10,0" Padding="10,8" Background="{Binding MarkerFill}" BorderBrush="{Binding MarkerBrush}" BorderThickness="1"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="Bold"/><TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9"/></DockPanel><TextBlock Text="{Binding ShortTitle}" TextDecorations="{Binding TextDecorations}" Foreground="{Binding TitleBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="FullQuestPage" Visibility="Collapsed" Margin="8,8,8,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="WALKTHROUGH" Style="{StaticResource Label}"/><TextBlock x:Name="FullQuestHeading" Text="Full quest" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock x:Name="FullQuestSubheading" Text="Complete map steps" Foreground="{StaticResource TextSoft}" FontSize="14" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Row="1" Margin="0,14,0,10"><ComboBox x:Name="FullQuestMapBox" Width="290" HorizontalAlignment="Left" Padding="8" SelectionChanged="FullQuestMapChanged"/><ItemsControl x:Name="FullQuestRouteTabs" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Key}" Click="SelectFullQuestRoute" Style="{StaticResource RailButton}" Padding="12,7" Margin="0,0,8,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     <Border Grid.Row="2" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" CornerRadius="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="FullQuestSteps"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12" Margin="0,0,0,9" CornerRadius="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="FullQuestStepToggled" Unchecked="FullQuestStepToggled" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Instruction}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextMain}" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0"/><ItemsControl ItemsSource="{Binding Checklists}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSoft}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding IconPath}" Width="26" Height="26" Stretch="Uniform" ToolTip="In-game item art"/><CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="FullQuestItemToggled" Unchecked="FullQuestItemToggled" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMain}" TextDecorations="{Binding TextDecorations}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding Location}" Foreground="{StaticResource TextSoft}" TextDecorations="{Binding TextDecorations}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Detection}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
    </Grid>
    <Grid x:Name="SideEasterEggsPage" Visibility="Collapsed" Margin="8,8,8,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="OPTIONAL OBJECTIVES" Style="{StaticResource Label}"/><TextBlock Text="Side Easter Eggs" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="Map secrets, music quests, and optional item hunts." Foreground="{StaticResource TextSoft}" FontSize="14"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10"><ComboBox x:Name="SideEggMapBox" Width="290" HorizontalAlignment="Left" Padding="8" SelectionChanged="SideEggMapChanged"/><TextBlock Text="Manual checklist · steps and trigger contracts are catalogued from stock scripts" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></StackPanel>
     <Border Grid.Row="2" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" CornerRadius="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SideEggSections"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12" Margin="0,0,0,11" CornerRadius="2"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Steps}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="SideEggStepToggled" Unchecked="SideEggStepToggled" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextMain}" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding Location}" TextDecorations="{Binding TextDecorations}" Foreground="{StaticResource TextSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding TrackingStatus}" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,3,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Evidence}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
    </Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="8,10"><TextBlock Text="PREFERENCES" Style="{StaticResource Label}"/><TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,11,0,8"/><TextBlock Text="Choose a sample mission or connect an event file from your game. Player count, route, and objectives follow the active script." Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" FontSize="14"/>
     <TextBox x:Name="PathBox" Margin="0,18,0,12" Padding="12" FontSize="13"/>
     <WrapPanel Margin="0,0,0,12"><ComboBox x:Name="SampleBox" Width="255" SelectedIndex="0" Padding="8" Margin="0,0,10,0"><ComboBoxItem Content="Ascension · Sample Run" Tag="ascension-session.jsonl"/><ComboBoxItem Content="Call of the Dead · Generator Preview" Tag="call-of-the-dead-session.jsonl"/><ComboBoxItem Content="Shangri-La · Tile Progress Preview" Tag="shangri-la-session.jsonl"/><ComboBoxItem Content="Moon · Soul Tube Preview" Tag="moon-session.jsonl"/><ComboBoxItem Content="Moon · Samantha Says Preview" Tag="moon-samantha-session.jsonl"/><ComboBoxItem Content="Moon · Panel Hack Preview" Tag="moon-panels-session.jsonl"/></ComboBox><Button Content="LOAD BUILT-IN PREVIEW" Click="LoadBuiltInSample" Style="{StaticResource ActionButton}"/></WrapPanel>
     <WrapPanel><Button Content="CHOOSE SESSION FILE" Click="BrowseSource" Style="{StaticResource ActionButton}"/><Button Content="PLAY SAVED SESSION" Click="LoadReplay" Style="{StaticResource ActionButton}"/><Button x:Name="ConnectGameButton" Content="CONNECT TO BO1 GAME" Click="ConnectSelectedGame" Style="{StaticResource ActionButton}"/><Button Content="FOLLOW SESSION FILE" Click="LoadTail" Style="{StaticResource ActionButton}"/></WrapPanel>
     <Border x:Name="PathChoicePanel" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,22,0,0"><StackPanel><TextBlock Text="CALL OF THE DEAD ROUTE" Style="{StaticResource Label}"/><TextBlock Text="Choose the branch for this lobby. The tracker will keep both routes separate until the route is confirmed." Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,8,0,10"/><WrapPanel><ComboBox x:Name="PathChoiceBox" Width="220" SelectedIndex="0" Padding="8" Margin="0,0,10,0"><ComboBoxItem Content="Stand-In" Tag="stand_in"/><ComboBoxItem Content="Ensemble Cast" Tag="ensemble_cast"/></ComboBox><Button Content="USE THIS ROUTE" Click="ApplyPathChoice" Style="{StaticResource ActionButton}"/></WrapPanel></StackPanel></Border>
     <TextBlock x:Name="SettingsStatus" Margin="0,18,0,0" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap"/>
     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" Margin="0,22,0,0" CornerRadius="3"><StackPanel><TextBlock Text="ARTWORK &amp; CREDITS" Style="{StaticResource Label}"/><TextBlock Text="Map banners use loading-screen artwork from the original Black Ops Zombies maps." Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="22"/></StackPanel></Border>
    </StackPanel></ScrollViewer></Grid>
    <Grid x:Name="DiagnosticsPage" Visibility="Collapsed"><StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="8,10"><TextBlock Text="SESSION STATUS" Style="{StaticResource Label}"/><TextBlock Text="Diagnostics" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20" CornerRadius="3"><TextBlock x:Name="DiagnosticsText" Foreground="{StaticResource TextSoft}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" LineHeight="22"/></Border></StackPanel></Grid>
   </Grid>
   <DockPanel Grid.Row="1" LastChildFill="False" Margin="1,9,1,0"><TextBlock Text="ZOMBIES TRACKER  /  FIELD COMPANION" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/><TextBlock Text="TELEMETRY OBSERVER" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold"/></DockPanel>
  </Grid>
 </Grid>
