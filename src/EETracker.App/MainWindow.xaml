<Window x:Class="EETracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zombies Tracker" Width="1600" Height="940" MinWidth="1100" MinHeight="720"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextMain}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- Fixed, quiet navigation rail for the second-screen layout. -->
  <Border Grid.Column="0" Background="#101514" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="18,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="ZOMBIES" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="TRACKER" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0"/><TextBlock Text="FIELD COMPANION" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="10" Margin="2,7,0,0"/><UniformGrid Columns="2" Margin="2,15,2,0"><Button x:Name="Bo1Tab" Content="BO1" Click="SelectBo1" Style="{StaticResource RailActiveButton}" Padding="4,9" HorizontalContentAlignment="Center"/><Button x:Name="Bo2Tab" Content="BO2" Click="SelectBo2" Style="{StaticResource RailButton}" Padding="4,9" HorizontalContentAlignment="Center"/></UniformGrid></StackPanel>
    <Border Grid.Row="2" Height="1" Background="{StaticResource Line}"/>
    <StackPanel Grid.Row="3" Margin="0,15,0,0">
      <Button Content="◎   CURRENT" Click="ShowMain" Style="{StaticResource RailActiveButton}"/>
      <Button Content="▤   FULL QUEST" Click="ShowFullQuest" Style="{StaticResource RailButton}"/>
      <Button Content="♫   SIDE EASTER EGGS" Click="ShowSideEasterEggs" Style="{StaticResource RailButton}"/>
      <Button Content="♟   SESSION" Click="ShowDiagnostics" Style="{StaticResource RailButton}"/>
     </StackPanel>
     <StackPanel Grid.Row="4"><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/><Button Content="⚙   SETTINGS" Click="ShowSettings" Style="{StaticResource RailButton}"/><Button Content="⌁   DIAGNOSTICS" Click="ShowDiagnostics" Style="{StaticResource RailButton}"/><TextBlock Text="OBSERVER ONLY" Foreground="{StaticResource TextMuted}" FontSize="8" FontWeight="Bold" Margin="8,18,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="22,18,22,14">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <Grid x:Name="MissionPage">
     <Grid.RowDefinitions><RowDefinition Height="174"/><RowDefinition Height="*" MinHeight="330"/></Grid.RowDefinitions>
     <!-- Original cinematic map artwork and session summary; all controls remain native WPF. -->
     <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="4.7*" MinWidth="350"/><ColumnDefinition Width="0.72*" MinWidth="110"/><ColumnDefinition Width="0.72*" MinWidth="110"/><ColumnDefinition Width="1.25*" MinWidth="190"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True" Margin="0,0,10,0" CornerRadius="3">
       <Grid><Image x:Name="BannerArtwork" Source="/Assets/ascension-banner.png" Stretch="UniformToFill"/><Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#A8090D0B" Offset="0"/><GradientStop Color="#24090D0B" Offset="0.52"/><GradientStop Color="#78090D0B" Offset="1"/></LinearGradientBrush></Border.Background></Border><Grid Margin="20,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="2"><TextBlock x:Name="MapTitle" Text="AWAITING SESSION" FontFamily="Bahnschrift SemiCondensed" FontSize="48" FontWeight="Bold"/><TextBlock x:Name="QuestTitle" Text="MAIN QUEST" Foreground="#D5DFDA" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Margin="2,-3,0,0"/></StackPanel>
       </Grid></Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,10,0" CornerRadius="3" Padding="18,15"><StackPanel VerticalAlignment="Center"><TextBlock Text="ROUND" Style="{StaticResource Label}"/><TextBlock x:Name="RoundText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="48" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="CURRENT WAVE" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,1,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,10,0" CornerRadius="3" Padding="18,15"><StackPanel VerticalAlignment="Center"><TextBlock Text="PLAYERS" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0"><TextBlock x:Name="PlayersText" Text="—" FontFamily="Bahnschrift SemiCondensed" FontSize="48" FontWeight="Bold"/><TextBlock Text=" / 4" Foreground="{StaticResource TextMuted}" FontSize="16" VerticalAlignment="Bottom" Margin="4,0,0,5"/></StackPanel><TextBlock Text="IN SESSION" Foreground="{StaticResource TextMuted}" FontSize="8" Margin="0,1,0,0"/></StackPanel></Border>
      <Border Grid.Column="3" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="18,15"><StackPanel VerticalAlignment="Center"><TextBlock Text="CONNECTION" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="ConnectionDot" Width="13" Height="13" Fill="{StaticResource AccentAmber}" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock x:Name="ConnectionText" Text="WAITING" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="Bold"/></StackPanel><TextBlock x:Name="RuntimeText" Text="PLUTONIUM T5" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="18,5,0,0"/></StackPanel></Border>
     </Grid>
     <Border x:Name="WaitingMatchOverlay" Grid.Row="0" Visibility="Collapsed" Background="#F0131917" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" CornerRadius="3" Margin="0,0,10,14" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="MATCH MONITOR" Foreground="{StaticResource AccentGold}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="WAITING FOR MATCH" FontFamily="Bahnschrift SemiCondensed" FontSize="34" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/><TextBlock Text="Listening for Black Ops 1 and Black Ops 2" Foreground="{StaticResource TextSoft}" FontSize="13" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel>
     </Border>
     <!-- At normal widths, objective, preparation, and next step share one aligned band. -->
     <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0" CornerRadius="3">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,11"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" Foreground="{StaticResource TextSoft}" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Text="CURRENT OBJECTIVE" Style="{StaticResource SectionHeading}"/></StackPanel><Border x:Name="DetectionBadge" DockPanel.Dock="Right" Background="#17271E" BorderBrush="#5A9870" BorderThickness="1" Padding="10,5" CornerRadius="2"><TextBlock x:Name="DetectionText" Text="QUEST STATE" Foreground="{StaticResource AccentOlive}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/></Border></DockPanel></Border>
        <Grid Grid.Row="1" Margin="26,12,26,14">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="180"/></Grid.RowDefinitions>
         <StackPanel Margin="0,4,0,0" HorizontalAlignment="Stretch">
          <TextBlock x:Name="ObjectiveText" Text="Waiting for game session" FontFamily="Bahnschrift SemiCondensed" FontSize="38" FontWeight="Bold" Foreground="{StaticResource AccentGold}" TextWrapping="Wrap" Margin="0,0,0,5"/>
          <TextBlock x:Name="InstructionText" Text="Connect to a game or load a preview." Foreground="{StaticResource TextSoft}" FontSize="17" TextWrapping="Wrap" LineHeight="26" MaxWidth="900" HorizontalAlignment="Left"/>
         </StackPanel>
         <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top">
          <StackPanel HorizontalAlignment="Stretch">
            <ItemsControl x:Name="ObjectiveChecklistItems" Visibility="Collapsed"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,8" Margin="0,0,0,7" CornerRadius="2"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Items}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="ObjectiveChecklistItemToggled" Unchecked="ObjectiveChecklistItemToggled" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMain}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Location}" Foreground="{StaticResource TextSoft}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
           <TextBlock x:Name="PressureTimerText" Visibility="Collapsed" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
           <TextBlock x:Name="LunaProgressText" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
           <TextBlock x:Name="SamanthaPromptText" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentOlive}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
           <TextBlock x:Name="RichtofenCueText" Visibility="Collapsed" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
           <Border x:Name="BranchOptionsPanel" Visibility="Collapsed" Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="PATH CHOICE · A RICHTOFEN  /  B MAXIS" Style="{StaticResource Label}" Margin="2,0,2,3"/><TextBlock Text="Follow one route in-game. The observer will confirm which path your lobby starts." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,7"/><ItemsControl x:Name="BranchOptionsItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="4" CornerRadius="2"><StackPanel><TextBlock Text="{Binding ChoiceLabel}" Foreground="{StaticResource AccentGold}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding FirstObjective}" Foreground="{StaticResource TextMain}" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,4"/><TextBlock Text="{Binding Instruction}" Foreground="{StaticResource TextSoft}" FontSize="13" TextWrapping="Wrap" LineHeight="19"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
           <Grid x:Name="TrackerProgressPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="156"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="QuestRingContainer" Grid.Column="1" Width="156" Height="156" HorizontalAlignment="Center"><Ellipse Stroke="#3E4744" StrokeThickness="12"/><Path x:Name="QuestRingProgress" Stroke="{StaticResource AccentGold}" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="QuestRingText" Text="0 / 0" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="QuestRingLabel" Text="CHECKS" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Grid>
           <ItemsControl x:Name="StepTrackers" Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10" Margin="0,0,0,8" CornerRadius="2"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="Bold" Margin="14,0,0,0"/></DockPanel><ProgressBar Height="7" Minimum="0" Maximum="{Binding Maximum, Mode=OneWay}" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding ProgressBarVisibility}" Margin="0,10,0,0" Background="{StaticResource Line}" Foreground="{StaticResource AccentGold}" BorderThickness="0"/><ItemsControl ItemsSource="{Binding Checkpoints}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontSize="19" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextMain}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding MarkerBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Grid>
           <StackPanel x:Name="SoulTanksPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,12,0,0"><TextBlock Text="MOON SOUL CANISTERS" Style="{StaticResource Label}" Margin="8,6,8,6" HorizontalAlignment="Center"/><UniformGrid Columns="1" Margin="8,0,8,8"><StackPanel x:Name="SoulTank1Panel" Margin="0,0,0,10"><TextBlock Text="CANISTER 1" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank1Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank1Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank2Panel" Margin="0,0,0,10"><TextBlock Text="CANISTER 2" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank2Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank2Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank3Panel" Margin="0,0,0,10"><TextBlock Text="CANISTER 3" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank3Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank3Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel><StackPanel x:Name="SoulTank4Panel"><TextBlock Text="CANISTER 4" Foreground="{StaticResource TextSoft}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,0,0,5"/><ProgressBar x:Name="SoulTank4Bar" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentGold}" Background="{StaticResource Line}" BorderThickness="0"/><TextBlock x:Name="SoulTank4Text" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" Margin="0,3,0,0"/></StackPanel></UniformGrid></StackPanel>
          </StackPanel>
          </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,10"><DockPanel LastChildFill="False"><TextBlock x:Name="ObjectiveCounter" Text="FLOW NOT LOADED" Foreground="{StaticResource AccentOlive}" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="RecentSignalText" Text="Awaiting quest signal" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
       </Grid>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="0.9*"/></Grid.RowDefinitions>
       <Border Grid.Row="0" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,10" CornerRadius="3">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="17,11"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="⚒" Foreground="{StaticResource TextSoft}" FontSize="23" Margin="0,0,13,0"/><TextBlock Text="PREPARATION" Style="{StaticResource SectionHeading}"/></StackPanel><TextBlock Text="BEFORE YOU MOVE" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/></DockPanel></Border>
          <ScrollViewer Grid.Row="1" Margin="12,4,12,6" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="PreparationItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="PreparationRequirementToggled" Unchecked="PreparationRequirementToggled" VerticalAlignment="Center" Margin="0,3,2,3"/><TextBlock Text="{Binding Text}" Grid.Column="1" Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,3,4,3" LineHeight="18"/><Border Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
       </Border>
       <Border Grid.Row="1" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,10" CornerRadius="3">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Border Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="17,11"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal"><TextBlock Text="»" Foreground="{StaticResource TextSoft}" FontSize="27" FontWeight="Bold" Margin="0,0,13,0"/><TextBlock Text="NEXT STEP" Style="{StaticResource SectionHeading}"/></StackPanel><TextBlock Text="UP NEXT" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/></DockPanel></Border>
         <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,15,22,15" VerticalAlignment="Center"><TextBlock x:Name="NextText" Text="Waiting for quest signals." FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="NextInstructionText" Visibility="Collapsed" Foreground="{StaticResource TextSoft}" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0"/><TextBlock x:Name="PreviousText" Text="Previous: —" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,13,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
        </Grid>
       </Border>
      </Grid>
     </Grid>
     <!-- Same ordered projection as the QuestEngine, presented as a quiet, scroll-safe timeline. -->
     <Border x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed" MinHeight="112" MaxHeight="168" VerticalAlignment="Bottom" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="10,5,10,4">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel><TextBlock Text="QUEST FLOW" Style="{StaticResource Label}"/><TextBlock x:Name="ProgressText" Text="STEP 0 / 0" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="11" FontWeight="Bold" DockPanel.Dock="Right"/></DockPanel>
       <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsControl x:Name="ProgressList" Margin="4,8,4,2"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="240" Margin="0,0,10,0" Padding="10,8" Background="{Binding MarkerFill}" BorderBrush="{Binding MarkerBrush}" BorderThickness="1"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="Bold"/><TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9"/></DockPanel><TextBlock Text="{Binding ShortTitle}" Foreground="{Binding TitleBrush}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>
     </Border>
    </Grid>
    <Grid x:Name="FullQuestPage" Visibility="Collapsed" Margin="8,8,8,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="WALKTHROUGH" Style="{StaticResource Label}"/><TextBlock x:Name="FullQuestHeading" Text="Full quest" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock x:Name="FullQuestSubheading" Text="Complete map steps" Foreground="{StaticResource TextSoft}" FontSize="14" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Row="1" Margin="0,14,0,10"><ComboBox x:Name="FullQuestMapBox" Width="290" HorizontalAlignment="Left" Padding="8" SelectionChanged="FullQuestMapChanged"/><ItemsControl x:Name="FullQuestRouteTabs" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Key}" Click="SelectFullQuestRoute" Style="{StaticResource RailButton}" Padding="12,7" Margin="0,0,8,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     <Border Grid.Row="2" Background="{StaticResource PanelGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="18" CornerRadius="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="FullQuestSteps"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#171D1C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,12" Margin="0,0,0,9" CornerRadius="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="FullQuestStepToggled" Unchecked="FullQuestStepToggled" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentGold}" FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Instruction}" Foreground="{StaticResource TextMain}" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0"/><ItemsControl ItemsSource="{Binding Checklists}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSoft}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="FullQuestItemToggled" Unchecked="FullQuestItemToggled" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMain}" TextDecorations="{Binding TextDecorations}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding Location}" Foreground="{StaticResource TextSoft}" TextDecorations="{Binding TextDecorations}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Detection}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
