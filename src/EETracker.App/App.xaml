<Application x:Class="EETracker.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
 <SolidColorBrush x:Key="Canvas" Color="#0D1110"/><SolidColorBrush x:Key="Panel" Color="#141A19"/><SolidColorBrush x:Key="PanelRaised" Color="#1A2220"/><SolidColorBrush x:Key="Line" Color="#39433F"/>
 <SolidColorBrush x:Key="TextMain" Color="#F1F2EE"/><SolidColorBrush x:Key="TextSoft" Color="#B7C0BF"/><SolidColorBrush x:Key="TextMuted" Color="#82908D"/>
 <SolidColorBrush x:Key="AccentOlive" Color="#80DBA0"/><SolidColorBrush x:Key="AccentGold" Color="#F3D364"/><SolidColorBrush x:Key="AccentRed" Color="#B65448"/><SolidColorBrush x:Key="AccentAmber" Color="#D9B769"/>
 <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#171D1C" Offset="0"/><GradientStop Color="#101615" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#232A29" Offset="0"/><GradientStop Color="#171D1C" Offset="1"/></LinearGradientBrush>
 <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentGold}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/></Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
 <Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextSoft}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,10"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="RailButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextSoft}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,16"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,2,0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#252D27"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="RailActiveButton" TargetType="Button" BasedOn="{StaticResource RailButton}"><Setter Property="Background" Value="#332D1E"/><Setter Property="Foreground" Value="{StaticResource AccentGold}"/></Style>
 <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Background" Value="#394433"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
</Application.Resources></Application>
